APP_NAME=HIMATKN API
APP_ENV=development
DEBUG=true
DATABASE_URL=mysql+pymysql://himatkn_app:CHANGE_ME@127.0.0.1:3306/himatkn_v2?charset=utf8mb4
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=himatkn-api
JWT_AUDIENCE=himatkn-admin
JWT_EXPIRE_MINUTES=30
COOKIE_NAME=himatkn_access
CSRF_COOKIE_NAME=himatkn_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXY_IPS=
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_FAIL_CLOSED=true
REDIS_URL=
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_ACCOUNT_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=60
GENERAL_READ_LIMIT=120
GENERAL_READ_WINDOW_SECONDS=60
GENERAL_WRITE_LIMIT=60
GENERAL_WRITE_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=4300000
MAX_UPLOAD_BYTES=4194304
MAX_IMAGE_WIDTH=2400
MAX_IMAGE_HEIGHT=2400
IMAGE_JPEG_QUALITY=82
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME
ADMIN_DEFAULT_ROLE=superadmin
